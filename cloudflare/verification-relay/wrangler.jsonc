{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "osrp-verification-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 4 * * *"]
